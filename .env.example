# ===========================================================================
# omni-video-studio — environment
# ===========================================================================
# This platform uses a Human-in-the-Loop PROMPT RELAY for script generation:
# the backend assembles a master prompt you paste into Gemini Advanced / Claude
# Pro in your browser, so NO LLM API key is required. Everything below is
# optional and only unlocks the publish side of the pipeline.

# On-screen brand (wordmark, outro CTA, thumbnail).
CHANNEL_NAME=Omni Studio

# ---------------------------------------------------------------------------
# Trend radar (zero-cost, no API keys)
# ---------------------------------------------------------------------------
# Comma list of Google Trends geos to aggregate.
TRENDS_GEOS=IN,US
# How long to cache a trends sweep before re-scraping (seconds).
TRENDS_CACHE_SECONDS=900

# ---------------------------------------------------------------------------
# Telegram HITL approval bot (optional locally, recommended for CI)
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=123456789:ABCDEF...
TELEGRAM_CHAT_ID=987654321
# How long to wait for your Approve/Cancel tap before giving up (minutes).
APPROVAL_WINDOW_MINUTES=120
# Fail-closed: no tap within the window => NOT published. true = publish on timeout.
APPROVE_ON_TIMEOUT=false

# ---------------------------------------------------------------------------
# YouTube Data API v3 OAuth2 credentials (optional — publish step only)
# ---------------------------------------------------------------------------
YOUTUBE_CLIENT_ID=your_client_id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=your_client_secret
YOUTUBE_REFRESH_TOKEN=your_oauth_refresh_token
DRY_RUN_SKIP_UPLOAD=false

# ---------------------------------------------------------------------------
# Audio
# ---------------------------------------------------------------------------
# edge-tts speaking rate (percentage, +/-). Personas are chosen by genre.
EDGE_TTS_RATE=-2%
KOKORO_SPEED=1.02

# ---------------------------------------------------------------------------
# Background music (mood-matched bed under the narration)
# ---------------------------------------------------------------------------
# Drop royalty-free files in agent-backend/assets/music/<mood>/ to use those;
# otherwise a fresh procedural ambient bed is generated every render.
BACKGROUND_MUSIC_ENABLED=true
MUSIC_LEVEL_DBFS=-28
MUSIC_FADE_MS=2500
